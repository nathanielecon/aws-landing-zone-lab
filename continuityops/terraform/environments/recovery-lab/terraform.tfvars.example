# Example values for continuityops-recovery (destructive drills / synthetic data).
# Copy to terraform.tfvars locally. Never commit real account IDs or secrets.

aws_region         = "us-east-1"
aws_account_id     = "REPLACE_ME"
vpc_cidr           = "10.43.0.0/16"
availability_zones = ["us-east-1a", "us-east-1b"]
enable_nat_gateway = false
kubernetes_version = "1.29"
node_instance_type = "t3.medium"
node_desired_size  = 1

lambda_package_path = "../../../serverless/build/worker.zip"
alarm_sns_topic_arn = ""
