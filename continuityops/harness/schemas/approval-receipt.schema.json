{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "continuityops-approval-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gate_id",
    "candidate_sha",
    "bundle_hash",
    "changed_paths",
    "environment",
    "validation_digest",
    "approver",
    "decision",
    "expires_at",
    "signed_at"
  ],
  "properties": {
    "schema_version": { "const": "continuityops-approval-receipt-v1" },
    "gate_id": { "enum": ["H0", "H1", "H2", "H3", "H4", "H5", "H6"] },
    "candidate_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "bundle_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "changed_paths": { "type": "array", "items": { "type": "string" } },
    "environment": { "type": "string" },
    "validation_digest": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "approver": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["approve", "reject"] },
    "expires_at": { "type": "string" },
    "signed_at": { "type": "string" },
    "notes": { "type": "string" }
  }
}
